# Everything below is generated by a real install/run and is specific to
# that machine -- a fresh Setup.bat run regenerates all of it. None of it
# should ever be committed.

# installer/ -- first-time setup working state
/installer/android-sdk/
/installer/_work/
/installer/_cmdline_tools_extract/
/installer/commandlinetools.zip
/installer/keystore/
/installer/input/*.apk
/installer/tools/build-tools/

# bridge/ -- per-install config, caches, and the portable SDK/AVD copy
/bridge/android-sdk-portable/
/bridge/config.json
/bridge/.path_cache.json
/bridge/.runtime_state.json
/bridge/emulator.log
/bridge/bridge.log
/bridge/stop.log
/bridge/.iisu_icon.ico
/bridge/_icon_extract_tmp/

# Python
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
Thumbs.db

# This checkout's working directory also holds unrelated local files that
# were never part of this project and must never be tracked here: personal
# notes, other experiments living alongside it, and build/decompile output
# containing iiSU's own copyrighted material. Explicit and anchored to the
# repo root, so a future `git add -A` can't sweep any of it in by accident.
/.claude/
/Homelab-Knowledge-Base.md
/iiSU-PC-PROJECT-CONTEXT.md
/dist/
/tools/
/stub-duckstation/
/iiSU-PC/
/iiSU-analysis/
/iiSU-decompiled/
/iiSU-smali/
/iiSU-Alpha-*.apk
/iiSU-patched*.apk
/iiSU-patched*.apk.idsig
